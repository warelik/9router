+function readVarint(buf, i) {
+  let value = 0n;
+  for (let shift = 0n; shift < 70n && i < buf.length; shift += 7n) {
+    const byte = buf[i++];
+    value |= BigInt(byte & 0x7f) << shift;
+    if (byte < 0x80) return { value, next: i };
+  }
+  return null;
