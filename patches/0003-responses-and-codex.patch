+    content: [{ type: "output_text", text: "ok", annotations: [] }],
+  }],
+};
+
+function okResponse() {
+  return new Response(JSON.stringify(RESPONSE_JSON), {
+    status: 200, headers: { "content-type": "application/json" },
+  });
+}
+
+describe("toPortableResponsesInput", () => {
