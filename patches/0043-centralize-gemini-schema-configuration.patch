+  it("proto schema tables normalize types and gate legacy proto shapes", () => {
+    const input = {
+      type: "OBJECT",
+      properties: {
+        name: { type: "STRING" },
+        count: { type: "ARRAY", items: { type: "INTEGER" } },
+      },
+      anyOf: [{ type: "NULL" }],
+    };
+    const lowered = lowerProtoSchemaTypes(input);
+    expect(lowered).toBe(input);
+    expect(lowered).toEqual({
+      type: "object",
+      properties: {
+        name: { type: "string" },
+        count: { type: "array", items: { type: "integer" } },
+      },
+      anyOf: [{ type: "null" }],
+    });
+    expect(isLegacyGeminiSchema({
+      type: "OBJECT",
+      properties: { name: { type: "STRING" } },
+      required: ["name"],
+    })).toBe(true);
+    expect(isLegacyGeminiSchema({
+      type: "OBJECT",
+      anyOf: [{ type: "STRING" }],
+    })).toBe(false);
+  });
+
   it("isLegacyGeminiSchema accepts proto shapes and rejects non-proto ones", () => {
     expect(isLegacyGeminiSchema({ type: "object", properties: { a: { type: "string" } }, required: ["a"], propertyOrdering: ["a"], enum: undefined })).toBe(true);
     expect(isLegacyGeminiSchema({ type: "array", items: { type: "string" } })).toBe(true);
