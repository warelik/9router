+});
+
+describe("AIStudio credential validation", () => {
+  const request = key => new Request("http://localhost/api/providers/validate", {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ provider: "aistudio", apiKey: key }),
