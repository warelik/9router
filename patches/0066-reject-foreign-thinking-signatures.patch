From e19f22b872df3433883d31c71ffd7d9e88f53471 Mon Sep 17 00:00:00 2001
From: warelik <warelik@gmail.com>
Date: Fri, 23 Oct 2026 16:33:54 +0000
Subject: [PATCH] Reject foreign thinking signatures that only share Claude's
 leading byte

The Claude signature check accepted any decoded value whose first bytes are
0x12 (or 0x08 <varint> 0x12). Another member of an Anthropic-format combo,
kimi-for-coding, signs its thinking with opaque bytes; those that happen to
start with 0x12 passed the check and were forwarded to api.anthropic.com,
which answered 400 "Invalid `signature` in `thinking` block" on every retry
of the same history.

A Claude signature is one complete protobuf message, so the decoded bytes of
every form must now also parse as such. Over the signatures providers emitted
in the request logs, all 601 Claude ones (haiku, opus, sonnet 5.5) still pass
and all 664 kimi-for-coding ones are rejected; the old check passed some of
the latter.

The URL-safe fixture [0x12, 0xfb, 0xff] was not a complete message and is
replaced by [0x12, 0x02, 0xfb, 0xff], which keeps the URL-safe characters.
---
 open-sse/utils/claudeSignature.js             | 57 ++++++++++++++-
 .../claude-signature-foreign-opaque.test.js   | 69 +++++++++++++++++++
 .../claude-signature-versioned-form.test.js   |  2 +-
 3 files changed, 125 insertions(+), 3 deletions(-)
 create mode 100644 tests/unit/claude-signature-foreign-opaque.test.js

diff --git a/open-sse/utils/claudeSignature.js b/open-sse/utils/claudeSignature.js
index 0b865e3..17b9cd0 100644
--- a/open-sse/utils/claudeSignature.js
+++ b/open-sse/utils/claudeSignature.js
@@ -2,6 +2,7 @@
 // E-form: single-layer base64, decoded[0] == 0x12 (Claude marker).
 // C-form: single-layer base64, the same marker preceded by a protobuf field-1 varint (08 <version>), as in Claude 5.5.
 // Double-layer (R…/Q…): base64 of the E-/C-form text; outer decodes to base64 text, inner carries the marker.
+// The decoded bytes of every form must also be one complete protobuf message.
 // Cache prefix "...#sig" stripped before validation.
 
 const MAX_CLAUDE_SIGNATURE_LEN = 32 * 1024 * 1024;
@@ -25,6 +26,58 @@ function hasClaudeMarker(buf) {
   return i < buf.length && buf[i] === CLAUDE_SIGNATURE_MARKER;
 }
 
+function readVarint(buf, i) {
+  let value = 0n;
+  for (let shift = 0n; shift < 70n && i < buf.length; shift += 7n) {
+    const byte = buf[i++];
+    value |= BigInt(byte & 0x7f) << shift;
+    if (byte < 0x80) return { value, next: i };
+  }
+  return null;
+}
+
+// A Claude signature is one protobuf message: every byte belongs to a field
+// with a valid tag and wire type, and length-delimited fields end inside the
+// buffer. The marker test alone only looks at the leading bytes; another
+// provider's opaque signature passes it whenever its own first byte happens
+// to be 0x12, and Anthropic then rejects the forwarded block.
+function isCompleteProtobufMessage(buf) {
+  let i = 0;
+  while (i < buf.length) {
+    const tag = readVarint(buf, i);
+    if (!tag || tag.value >> 3n === 0n) return false;
+    i = tag.next;
+    switch (Number(tag.value & 7n)) {
+      case 0: {
+        const v = readVarint(buf, i);
+        if (!v) return false;
+        i = v.next;
+        break;
+      }
+      case 1:
+        i += 8;
+        break;
+      case 2: {
+        const len = readVarint(buf, i);
+        if (!len || len.value > BigInt(buf.length - len.next)) return false;
+        i = len.next + Number(len.value);
+        break;
+      }
+      case 5:
+        i += 4;
+        break;
+      default:
+        return false;
+    }
+    if (i > buf.length) return false;
+  }
+  return true;
+}
+
+function isClaudeSignatureBytes(buf) {
+  return buf?.length > 0 && hasClaudeMarker(buf) && isCompleteProtobufMessage(buf);
+}
+
 export function hasClaudeSignaturePrefix(rawSignature) {
   const sig = stripCachePrefix(rawSignature);
   return sig.length > 0 && (sig[0] === "E" || sig[0] === "R");
@@ -50,10 +103,10 @@ export function normalizeClaudeSignature(rawSignature) {
   try {
     const decoded = decodeBase64Strict(sig);
     if (!decoded?.length) return null;
-    if (hasClaudeMarker(decoded)) return sig;
+    if (isClaudeSignatureBytes(decoded)) return sig;
     const outerText = decoded.toString("latin1");
     const inner = decodeBase64Strict(outerText);
-    return inner?.length > 0 && hasClaudeMarker(inner) ? sig : null;
+    return isClaudeSignatureBytes(inner) ? sig : null;
   } catch {
     return null;
   }
diff --git a/tests/unit/claude-signature-foreign-opaque.test.js b/tests/unit/claude-signature-foreign-opaque.test.js
new file mode 100644
index 0000000..9717158
--- /dev/null
+++ b/tests/unit/claude-signature-foreign-opaque.test.js
@@ -0,0 +1,69 @@
+import { createHash } from "node:crypto";
+import { describe, it, expect } from "vitest";
+import { isValidClaudeSignature } from "../../open-sse/utils/claudeSignature.js";
+import { normalizeClaudePassthrough, prepareClaudeRequest } from "../../open-sse/translator/formats/claude.js";
+
+// Another provider behind an Anthropic-format combo (kimi-for-coding) signs
+// its thinking with opaque bytes that only look random. Some of them start
+// with 0x12, the leading byte of a Claude signature; Anthropic rejects such a
+// block ("Invalid `signature` in `thinking` block") on every retry.
+function opaqueSignature(seed, length, firstByte) {
+  const chunks = [];
+  for (let i = 0; Buffer.concat(chunks).length < length; i++) {
+    chunks.push(createHash("sha256").update(`${seed}:${i}`).digest());
+  }
+  const bytes = Buffer.concat(chunks).subarray(0, length);
+  bytes[0] = firstByte;
+  return bytes.toString("base64");
+}
+
+const b64 = bytes => Buffer.from(bytes).toString("base64");
+// Shape of a real Claude 5.5 signature: version varint, then field 2 holding
+// a nested message, every byte accounted for.
+const claudeLike = b64([0x08, 0x04, 0x12, 0x0a, 0x0a, 0x02, 0x08, 0x13, 0x42, 0x04, 0x74, 0x68, 0x69, 0x6e]);
+const foreignE = opaqueSignature("kimi-e", 3255, 0x12);
+const foreignC = opaqueSignature("kimi-c", 3255, 0x08);
+
+const historyWith = signature => ({
+  model: "claude-sonnet-5-5",
+  thinking: { type: "enabled", budget_tokens: 1024 },
+  messages: [
+    { role: "user", content: "read the file" },
+    {
+      role: "assistant",
+      content: [
+        { type: "thinking", thinking: "t", signature },
+        { type: "tool_use", id: "toolu_1", name: "read", input: {} }
+      ]
+    },
+    { role: "user", content: [{ type: "tool_result", tool_use_id: "toolu_1", content: "ok" }] }
+  ]
+});
+
+describe("foreign opaque signatures with a Claude-looking first byte", () => {
+  it("still accepts a complete Claude-shaped signature", () => {
+    expect(isValidClaudeSignature(claudeLike)).toBe(true);
+    expect(isValidClaudeSignature(Buffer.from(claudeLike).toString("base64"))).toBe(true);
+  });
+
+  it.each([
+    ["first byte 0x12", foreignE],
+    ["first byte 0x08", foreignC],
+    ["double-wrapped", Buffer.from(foreignE).toString("base64")],
+    ["truncated Claude signature", b64([0x08, 0x04, 0x12, 0x0a, 0x0a, 0x02])],
+    ["Claude signature with trailing bytes", b64([0x08, 0x04, 0x12, 0x01, 0x00, 0xff])],
+  ])("rejects %s", (_name, signature) => {
+    expect(isValidClaudeSignature(signature)).toBe(false);
+  });
+
+  it("never forwards the foreign block to Anthropic", () => {
+    const normalized = historyWith(foreignE);
+    normalizeClaudePassthrough(normalized, "claude-sonnet-5-5");
+    const prepared = prepareClaudeRequest(historyWith(foreignE), "claude", "sk-ant-api-test");
+    for (const body of [normalized, prepared]) {
+      const content = body.messages[1].content;
+      expect(content.some(block => block.signature === foreignE)).toBe(false);
+      expect(content.at(-1)).toMatchObject({ type: "tool_use", id: "toolu_1" });
+    }
+  });
+});
diff --git a/tests/unit/claude-signature-versioned-form.test.js b/tests/unit/claude-signature-versioned-form.test.js
index f53e10b..ab81dbc 100644
--- a/tests/unit/claude-signature-versioned-form.test.js
+++ b/tests/unit/claude-signature-versioned-form.test.js
@@ -57,7 +57,7 @@ describe("isValidClaudeSignature accepts every Claude signature form", () => {
 
   it.each([
     eForm.replace(/=+$/, ""), rForm.replace(/=+$/, ""),
-    Buffer.from([0x12, 0xfb, 0xff]).toString("base64url"),
+    Buffer.from([0x12, 0x02, 0xfb, 0xff]).toString("base64url"),
   ])("preserves a valid unpadded or URL-safe provider value %s", signature => {
     expect(isValidClaudeSignature(signature)).toBe(true);
     expect(normalizeClaudeSignature(signature)).toBe(signature);
-- 
2.55.0

