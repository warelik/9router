diff --git a/tests/unit/gemini-server-parts-isolation.test.js b/tests/unit/gemini-server-parts-isolation.test.js
new file mode 100644
index 0000000..e2949f2
--- /dev/null
+++ b/tests/unit/gemini-server-parts-isolation.test.js
@@ -0,0 +1,130 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { captureConversationId, captureSessionId } from "../../open-sse/utils/sessionManager.js";
+
+const rows = new Map();
+vi.mock("../../src/lib/db/helpers/kvStore.js", () => ({
+  makeKv: () => ({
+    get: async (key) => rows.get(key) ?? null,
+    set: async (key, value) => { rows.set(key, value); },
+    remove: async (key) => { rows.delete(key); },
+    getAll: async () => Object.fromEntries(rows),
+  }),
+}));
+
+let store;
+
+const MODEL = "gemini-3.8-flash";
+const partsFor = (label) => [{ thoughtSignature: `sig-${label}`, toolCall: { id: "call_1", toolType: "GOOGLE_SEARCH_WEB", args: { queries: [label] } } }];
+
+beforeEach(async () => {
+  rows.clear();
+  vi.resetModules();
+  store = await import("../../open-sse/services/thoughtSignatureStore.js");
+});
+
+describe("server-side tool parts are bound to session and scope", () => {
+  it("returns the stored parts verbatim for the same session, scope and id", () => {
+    store.storeGeminiServerParts("call_1", partsFor("A"), "session-a", MODEL, "scope-1");
+    expect(store.getGeminiServerPartsSync("call_1", "session-a", MODEL, "scope-1")).toEqual(partsFor("A"));
+  });
+
+  it("does not leak across sessions or scopes for the same call id", () => {
+    store.storeGeminiServerParts("call_1", partsFor("A"), "session-a", MODEL, "scope-1");
+    expect(store.getGeminiServerPartsSync("call_1", "session-b", MODEL, "scope-1")).toBeNull();
+    expect(store.getGeminiServerPartsSync("call_1", "session-a", MODEL, "scope-2")).toBeNull();
+    expect(store.getGeminiServerPartsSync("call_1", null, MODEL, "scope-1")).toBeNull();
+  });
+
+  it("keeps two scopes with the same id apart", () => {
+    store.storeGeminiServerParts("call_1", partsFor("one"), "session-a", MODEL, "scope-1");
+    store.storeGeminiServerParts("call_1", partsFor("two"), "session-a", MODEL, "scope-2");
+    expect(store.getGeminiServerPartsSync("call_1", "session-a", MODEL, "scope-1")).toEqual(partsFor("one"));
+    expect(store.getGeminiServerPartsSync("call_1", "session-a", MODEL, "scope-2")).toEqual(partsFor("two"));
+  });
+
+  it.each([
+    ["missing session", [undefined, "scope-1"]],
+    ["empty session", ["", "scope-1"]],
+    ["numeric session", [7, "scope-1"]],
+    ["missing scope", ["session-a", undefined]],
+    ["empty scope", ["session-a", ""]],
+    ["numeric scope", ["session-a", 7]],
+  ])("neither caches nor falls back with a %s", (_label, [sessionId, scope]) => {
+    store.storeGeminiServerParts("call_1", partsFor("A"), sessionId, MODEL, scope);
+    expect(rows.size).toBe(0);
+    store.storeGeminiServerParts("call_1", partsFor("B"), "session-a", MODEL, "scope-1");
+    expect(store.getGeminiServerPartsSync("call_1", sessionId, MODEL, scope)).toBeNull();
+  });
+
+  it("cannot collide through colon delimiters", () => {
+    store.storeGeminiServerParts("c:d", partsFor("first"), "a", MODEL, "b");
+    store.storeGeminiServerParts("d", partsFor("second"), "a:c", MODEL, "b");
+    expect(store.getGeminiServerPartsSync("c:d", "a", MODEL, "b")).toEqual(partsFor("first"));
+    expect(store.getGeminiServerPartsSync("d", "a:c", MODEL, "b")).toEqual(partsFor("second"));
+    expect(store.getGeminiServerPartsSync("d", "a", MODEL, "c:b")).toBeNull();
+  });
+
+  it("ignores a legacy unscoped entry written through the opaque store", () => {
+    store.storeGeminiThoughtSignature("serverparts:call_1", JSON.stringify(partsFor("legacy")), "session-a", MODEL);
+    store.storeGeminiThoughtSignature("serverparts:call_1", JSON.stringify(partsFor("legacy")), null, MODEL);
+    expect(store.getGeminiServerPartsSync("call_1", "session-a", MODEL, "scope-1")).toBeNull();
+    expect(store.getGeminiServerPartsSync("call_1", "session-b", MODEL, "scope-1")).toBeNull();
+  });
+
+  it("isolates turn-anchored parts with identical reasoning, content and scope", () => {
+    const turn = { reasoning: "thinking", content: "answer", scope: "scope-1" };
+    store.storeGeminiServerPartsForTurn({ ...turn, sessionId: "session-a" }, partsFor("A"), MODEL);
+    expect(store.findGeminiServerPartsForTurn({ ...turn, sessionId: "session-a" }, MODEL)).toEqual(partsFor("A"));
+    expect(store.findGeminiServerPartsForTurn({ ...turn, sessionId: "session-b" }, MODEL)).toBeNull();
+    expect(store.findGeminiServerPartsForTurn({ ...turn, sessionId: null }, MODEL)).toBeNull();
+    expect(store.findGeminiServerPartsForTurn({ ...turn, scope: "scope-2", sessionId: "session-a" }, MODEL)).toBeNull();
+  });
+
+  it("leaves the opaque thought-signature cache compatible", () => {
+    store.storeGeminiThoughtSignature("call_x", "opaque-sig", "session-a", MODEL);
+    expect(store.getGeminiThoughtSignatureSync("call_x", "session-a", MODEL)).toBe("opaque-sig");
+    expect(store.getGeminiThoughtSignatureSync("call_x", null, MODEL)).toBe("opaque-sig");
+  });
+});
+
+describe("captureConversationId", () => {
+  const capture = (rawHeaders, body = {}) => captureConversationId(body, { rawHeaders });
+
+  it.each([
+    ["no headers or body", {}, {}],
+    ["a plain metadata.user_id", {}, { metadata: { user_id: "user-123" } }],
+    ["a shared prompt_cache_key", {}, { prompt_cache_key: "shared-cache-key" }],
+    ["a client request id", { "x-client-request-id": "req-1" }, {}],
+    ["a workspace or account value", { "x-workspace-id": "ws-1", "x-account-id": "acct-1" }, { workspace_id: "ws-1" }],
+  ])("is never genuine for %s", (_label, headers, body) => {
+    expect(capture(headers, body)).toBeNull();
+  });
+
+  it("takes declared body and header identities", () => {
+    expect(capture({}, { session_id: "body-session" })).toBe("body-session");
+    expect(capture({}, { conversation_id: "conv-1", session_id: "body-session" })).toBe("conv-1");
+    expect(capture({ "session-id": "session-1" })).toBe("session-1");
+    expect(capture({ "x-session-id": "x-1", "session-id": "session-1" })).toBe("x-1");
+    expect(capture({ "x-amp-thread-id": "amp-1" })).toBe("amp-1");
+  });
+
+  it("prefers the Codex thread-id over the session-id and is stable across calls", () => {
+    const headers = { "session-id": "session-1", "thread-id": "thread-1" };
+    expect(capture(headers)).toBe("thread-1");
+    expect(capture(headers, { prompt_cache_key: "ignored" })).toBe("thread-1");
+    expect(capture({ "thread-id": "thread-1" })).toBe("thread-1");
+  });
+
+  it("recognizes Claude Code sessions", () => {
+    expect(capture({}, { metadata: { user_id: "user_abc_account__session_0123abcd-ef01" } })).toBe("claude:0123abcd-ef01");
+    expect(capture({ "x-claude-code-session-id": "cc-1" })).toBe("claude:cc-1");
+  });
+
+  it("does not change the provider transport session", () => {
+    const transport = captureSessionId({}, { rawHeaders: {} }, "selected-provider-credential");
+    expect(typeof transport).toBe("string");
+    expect(transport.length).toBeGreaterThan(0);
+    expect(capture({})).toBeNull();
+    expect(captureSessionId({}, { rawHeaders: {} }, "selected-provider-credential")).toBe(transport);
+  });
+});
diff --git a/tests/unit/gemini-tool-call-id-fifo.test.js b/tests/unit/gemini-tool-call-id-fifo.test.js
new file mode 100644
index 0000000..c1930f9
--- /dev/null
+++ b/tests/unit/gemini-tool-call-id-fifo.test.js
@@ -0,0 +1,118 @@
+import { describe, expect, it } from "vitest";
+
+import { openaiToGeminiRequest } from "../../open-sse/translator/request/openai-to-gemini.js";
+
+const MODEL = "gemini-3.8-flash";
+const call = (id, name, args = {}) => ({ id, type: "function", function: { name, arguments: JSON.stringify(args) } });
+const assistant = (...calls) => ({ role: "assistant", tool_calls: calls });
+const result = (id, content) => ({ role: "tool", tool_call_id: id, content });
+
+function convert(messages) {
+  const body = { model: MODEL, messages };
+  const before = JSON.stringify(body);
+  const out = openaiToGeminiRequest(MODEL, body, false);
+  expect(JSON.stringify(body)).toBe(before);
+  const parts = out.contents.flatMap((c) => c.parts);
+  return {
+    out,
+    calls: parts.filter((p) => p.functionCall).map((p) => p.functionCall),
+    responses: parts.filter((p) => p.functionResponse).map((p) => p.functionResponse),
+  };
+}
+
+describe("Gemini tool-call identity with repeated ids", () => {
+  it("answers each repeated id with its own call id, name and result", () => {
+    const { calls, responses } = convert([
+      { role: "user", content: "go" },
+      assistant(call("call_1", "read", { path: "a" })),
+      result("call_1", '{"text":"first"}'),
+      { role: "user", content: "again" },
+      assistant(call("call_1", "write", { path: "b" })),
+      result("call_1", '{"text":"second"}'),
+    ]);
+    expect(calls[0].id).toBe("call_1");
+    expect(new Set(calls.map((c) => c.id)).size).toBe(2);
+    expect(responses.map((r) => r.id)).toEqual(calls.map((c) => c.id));
+    expect(responses.map((r) => r.name)).toEqual(["read", "write"]);
+    expect(responses.map((r) => r.response)).toEqual([{ text: "first" }, { text: "second" }]);
+  });
+
+  it("matches results of duplicate sibling calls first-in first-out", () => {
+    const { calls, responses } = convert([
+      { role: "user", content: "go" },
+      assistant(call("call_dup", "alpha"), call("call_dup", "beta")),
+      result("call_dup", '{"v":1}'),
+      result("call_dup", '{"v":2}'),
+    ]);
+    expect(new Set(calls.map((c) => c.id)).size).toBe(2);
+    expect(responses.map((r) => [r.id, r.name, r.response])).toEqual([
+      [calls[0].id, "alpha", { v: 1 }],
+      [calls[1].id, "beta", { v: 2 }],
+    ]);
+  });
+
+  it("does not invent a functionResponse when the result is missing", () => {
+    const { calls, responses, out } = convert([
+      { role: "user", content: "go" },
+      assistant(call("call_missing", "read")),
+      { role: "user", content: "never mind" },
+    ]);
+    expect(calls).toHaveLength(1);
+    expect(responses).toHaveLength(0);
+    expect(JSON.stringify(out.contents)).not.toContain("functionResponse");
+  });
+
+  it("leaves already unique ids unchanged", () => {
+    const { calls, responses } = convert([
+      { role: "user", content: "go" },
+      assistant(call("call_a", "read"), call("call_b", "write")),
+      result("call_a", '{"ok":true}'),
+      result("call_b", '{"ok":false}'),
+    ]);
+    expect(calls.map((c) => c.id)).toEqual(["call_a", "call_b"]);
+    expect(responses.map((r) => [r.id, r.name])).toEqual([["call_a", "read"], ["call_b", "write"]]);
+  });
+
+  it("keeps the private representation of array and JSON null results", () => {
+    const { responses } = convert([
+      { role: "user", content: "go" },
+      assistant(call("call_arr", "list"), call("call_null", "nothing")),
+      result("call_arr", "[1,2]"),
+      result("call_null", "null"),
+    ]);
+    expect(responses[0].response).toEqual({ result: [1, 2] });
+    expect(responses[1].response).toEqual({ result: null });
+  });
+
+  describe("reserved response keys", () => {
+    const single = (content) => convert([
+      { role: "user", content: "go" },
+      assistant(call("call_ref", "fetch")),
+      result("call_ref", content),
+    ]);
+
+    it("forwards a payload carrying both reserved and renamed keys without losing either", () => {
+      const original = { $ref: "#/$defs/A", _ref: "separate", other: 1 };
+      const { responses } = single(JSON.stringify(original));
+      expect(responses).toHaveLength(1);
+      expect(responses[0]).toMatchObject({ id: "call_ref", name: "fetch" });
+      expect(JSON.parse(responses[0].response.result)).toEqual(original);
+    });
+
+    it("keeps reserved keys nested in objects and arrays", () => {
+      const original = { items: [{ $ref: "#/$defs/B", _ref: "kept" }], nested: { deeper: { $ref: "x", _ref: "y" } } };
+      const { responses } = single(JSON.stringify(original));
+      expect(JSON.parse(responses[0].response.result)).toEqual(original);
+    });
+
+    it("does not rewrite plain text that only mentions the key", () => {
+      const { responses } = single("see $ref in the schema");
+      expect(responses[0].response).toEqual({ result: "see $ref in the schema" });
+    });
+
+    it("leaves ordinary payloads unchanged", () => {
+      const { responses } = single('{"text":"fine","count":2}');
+      expect(responses[0].response).toEqual({ text: "fine", count: 2 });
+    });
+  });
+});
diff --git a/tests/unit/gemini-turn-signature.test.js b/tests/unit/gemini-turn-signature.test.js
new file mode 100644
index 0000000..5053c4a
--- /dev/null
+++ b/tests/unit/gemini-turn-signature.test.js
@@ -0,0 +1,195 @@
+import { describe, it, expect, vi } from "vitest";
+
+// Keep the signature store in RAM only; the SQLite kv layer is not under test here.
+vi.mock("@/lib/db/helpers/kvStore.js", () => ({
+  makeKv: () => ({
+    get: async () => null,
+    set: async () => {},
+    remove: async () => {},
+    getAll: async () => ({}),
+  }),
+}));
+
+const { geminiToOpenAIResponse } = await import("../../open-sse/translator/response/gemini-to-openai.js");
+const { openaiToGeminiRequest, openaiToGeminiCLIRequest, openaiToAntigravityRequest } = await import("../../open-sse/translator/request/openai-to-gemini.js");
+const { DEFAULT_THINKING_AG_SIGNATURE } = await import("../../open-sse/config/defaultThinkingSignature.js");
+
+// A model id is just a string here; only its family ("gemini") matters to the signature store.
+const MODEL = "gemini-turn-signature-test";
+
+const chunk = (parts, finishReason) => ({
+  responseId: "r1",
+  candidates: [{ content: { role: "model", parts }, ...(finishReason ? { finishReason } : {}) }],
+});
+
+// Translate the request that starts a turn, then stream the provider's answer to it, exactly as
+// the router does: the request translator leaves the history identity on `credentials`.
+function turn(history, chunks, sessionId = "authenticated-fixture-conversation") {
+  const credentials = { _geminiServerPartsSessionId: sessionId };
+  openaiToGeminiRequest(MODEL, { messages: history }, true, credentials);
+  const state = { model: MODEL, turnScope: credentials._geminiTurnScope, serverPartsSessionId: sessionId };
+  const out = [];
+  for (const c of chunks) out.push(...(geminiToOpenAIResponse(c, state) || []));
+  const delta = (k) => out.map((o) => o.choices?.[0]?.delta?.[k]).filter(Boolean).join("");
+  return { reasoning: delta("reasoning_content"), content: delta("content") };
+}
+
+function modelParts(body, sessionId = "authenticated-fixture-conversation") {
+  const req = openaiToGeminiRequest(MODEL, body, false, { _geminiServerPartsSessionId: sessionId });
+  return req.contents.filter((c) => c.role === "model").flatMap((c) => c.parts);
+}
+
+const ask = (text) => ({ role: "user", content: text });
+
+describe("signature of a tool-free thinking turn survives the round trip", () => {
+  it("separates identical turns across trusted tenants/conversations and refuses an unscoped lookup", () => {
+    const history = [ask("identical request")];
+    turn(history, [chunk([{ text: "identical answer", thoughtSignature: "tenant-one-signature" }], "STOP")], "tenant-one/conversation");
+    turn(history, [chunk([{ text: "identical answer", thoughtSignature: "tenant-two-signature" }], "STOP")], "tenant-two/conversation");
+    const body = { messages: [...history, { role: "assistant", content: "identical answer" }, ask("next")] };
+    expect(modelParts(body, "tenant-one/conversation")).toContainEqual({ text: "identical answer", thoughtSignature: "tenant-one-signature" });
+    expect(modelParts(body, "tenant-two/conversation")).toContainEqual({ text: "identical answer", thoughtSignature: "tenant-two-signature" });
+    expect(JSON.stringify(modelParts(body, null))).not.toContain("tenant-one-signature");
