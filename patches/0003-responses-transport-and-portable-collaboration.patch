+
+  it("forwards explicit none unchanged and returns the upstream 400", async () => {
+    proxyAwareFetchMock.mockResolvedValueOnce(new Response(
+      JSON.stringify({
+        error: {
+          message: "Unsupported reasoning effort: none",
+          type: "invalid_request_error",
+          code: "bad_request",
