     let quotaResetMs = null;
@@ -421,10 +479,10 @@ async function handleSingleModelChat(body, modelStr, clientRawRequest = null, re
       lastError = result.error;
       lastStatus = result.status;
       lastHeaders = upstreamResponseHeaders(result.response?.headers);
-      if (result.nativeResponse || options.sourceFormatOverride === "gemini") lastNativeResponse = result.response;
+      lastNativeResponse = result.nativeResponse === true ? result.response : null;
       continue;
     }
 
-    return result.response;
+    return chatCoreErrorResponse(result, options);
   }
 }
diff --git a/tests/unit/antigravity-native-gemini.test.js b/tests/unit/antigravity-native-gemini.test.js
