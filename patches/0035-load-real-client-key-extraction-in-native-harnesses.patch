@@ -111,6 +118,20 @@ function audioRequest(action = "streamGenerateContent") {
 describe("native Gemini endpoint entry contract", () => {
   beforeEach(load);
 
+it("loads the real client-key accessor for every supported credential location", () => {
+  for (const [headers, query, expected] of [
+    [{ Authorization: "Bearer bearer-fixture", "x-goog-api-key": "ignored" }, "?key=ignored", "bearer-fixture"],
+    [{ "x-api-key": "header-fixture" }, "", "header-fixture"],
+    [{ "x-goog-api-key": "google-fixture" }, "", "google-fixture"],
+    [{}, "?key=query-fixture", "query-fixture"],
+    [{}, "?$key=dollar-fixture", "dollar-fixture"],
+  ]) {
+    const { req } = request("gemini", "generateContent", nativeBody(), { headers, query });
+    expect(context.extractClientApiKey(req)).toBe(expected);
+  }
+});
+
+
   it.each(["generateContent", "streamGenerateContent"])("TTS %s waits for EOF and its account update", async action => {
     let releaseAccount;
     const accountUpdated = new Promise(resolve => { releaseAccount = resolve; });
