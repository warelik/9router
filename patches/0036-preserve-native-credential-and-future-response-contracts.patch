From: "github-actions[bot]"
 <41898282+github-actions[bot]@users.noreply.github.com>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH] Strip internal native credentials and preserve unprojected
 future responses

---
 open-sse/executors/default.js                 |  2 +-
 .../handlers/chatCore/nonStreamingHandler.js  |  2 +-
 open-sse/utils/streamHelpers.js               |  9 +++++---
 tests/unit/gemini-native-core.test.js         | 23 +++++++++++++------
 tests/unit/gemini-native-stream.test.js       |  2 +-
 5 files changed, 25 insertions(+), 13 deletions(-)

diff --git a/open-sse/executors/default.js b/open-sse/executors/default.js
index 0a2124a..e82aa9b 100644
--- a/open-sse/executors/default.js
+++ b/open-sse/executors/default.js
@@ -241,7 +241,7 @@ export class DefaultExecutor extends BaseExecutor {
       ]);
       for (const [name, value] of Object.entries(credentials.nativeGeminiRequest?.headers || {})) {
         const lower = name.toLowerCase();
-        if (!privateHeaders.has(lower) && !reserved.has(lower) && !lower.startsWith("x-forwarded-") && !lower.startsWith("x-9router-")) {
+        if (!privateHeaders.has(lower) && !reserved.has(lower) && !lower.startsWith("x-forwarded-") && !lower.startsWith("x-9router-") && !lower.startsWith("x-9r-")) {
           headers[name] = value;
         }
       }
diff --git a/open-sse/handlers/chatCore/nonStreamingHandler.js b/open-sse/handlers/chatCore/nonStreamingHandler.js
index c699b4a..67f92db 100644
--- a/open-sse/handlers/chatCore/nonStreamingHandler.js
+++ b/open-sse/handlers/chatCore/nonStreamingHandler.js
@@ -336,7 +336,7 @@ export async function handleNonStreamingResponse({ credentials, providerResponse
 
   reqLogger.logProviderResponse(providerResponse.status, providerResponse.statusText, providerResponse.headers, responseBody);
   if (isNativeGeminiResponse) {
-    if (!isValidNativeGeminiResponse(responseBody, nativeResponseProjection)) {
+    if (!isValidNativeGeminiResponse(responseBody, nativeResponseProjection, false, true)) {
       const message = `Invalid native Gemini response from ${provider}`;
       appendLog({ status: `FAILED ${HTTP_STATUS.BAD_GATEWAY}` });
       return nativeGeminiErrorResult(providerResponse, HTTP_STATUS.BAD_GATEWAY, message);
diff --git a/open-sse/utils/streamHelpers.js b/open-sse/utils/streamHelpers.js
index aaf2e60..b08fb5c 100644
--- a/open-sse/utils/streamHelpers.js
+++ b/open-sse/utils/streamHelpers.js
@@ -11,7 +11,7 @@ function nativeResponseProjectionAllowsEmpty(projection) {
   }) || false;
 }
 
-export function isValidNativeGeminiResponse(response, projection = null, allowUnrecognized = false) {
+export function isValidNativeGeminiResponse(response, projection = null, allowUnrecognized = false, allowOpaqueExtensions = false) {
   if (!response || typeof response !== "object" || Array.isArray(response)) return false;
   const allowsEmpty = nativeResponseProjectionAllowsEmpty(projection);
   if (!allowsEmpty && Object.keys(response).length === 0) return false;
@@ -22,9 +22,12 @@ export function isValidNativeGeminiResponse(response, projection = null, allowUn
   if (!allowsEmpty && Object.keys(nativeResponse).length === 0) return false;
   if (nativeResponse.error) return true;
   // GenerateContent metadata can be the whole reply. Keep unknown extensions
-  // opaque, while requiring a recognizable reply unless a mask projects it out.
+  // opaque for non-streaming replies. An SSE transport-only frame must not
+  // become successful response evidence at EOF.
   const nativeFields = ["candidates", "promptFeedback", "usageMetadata", "modelVersion", "responseId", "modelStatus", "createTime"];
-  if (!allowsEmpty && !allowUnrecognized && !nativeFields.some(field => Object.hasOwn(nativeResponse, field))) return false;
+  const bridgeFields = new Set(["message", "event", "data", "status", "code", "success", "response"]);
+  const hasOpaqueExtension = Object.keys(nativeResponse).some(field => !bridgeFields.has(field));
+  if (!allowsEmpty && !allowUnrecognized && !nativeFields.some(field => Object.hasOwn(nativeResponse, field)) && !(allowOpaqueExtensions && hasOpaqueExtension)) return false;
   if (nativeResponse.candidates !== undefined) {
     if (!Array.isArray(nativeResponse.candidates)) return false;
     for (const candidate of nativeResponse.candidates) {
diff --git a/tests/unit/gemini-native-core.test.js b/tests/unit/gemini-native-core.test.js
