From e83f1560e711731232e8f7cfa7a86bcec1109011 Mon Sep 17 00:00:00 2001
From: warelik <warelik@gmail.com>
Date: Sat, 7 Nov 2026 12:06:43 +0000
Subject: [PATCH] Divide 429 and 503 account cooldowns by three (0065)

---
 open-sse/config/errorConfig.js               |  8 ++++
 open-sse/services/accountFallback.js         | 18 +++++---
 tests/unit/account-cooldown-division.test.js | 45 ++++++++++++++++++++
 3 files changed, 65 insertions(+), 6 deletions(-)
 create mode 100644 tests/unit/account-cooldown-division.test.js

diff --git a/open-sse/config/errorConfig.js b/open-sse/config/errorConfig.js
index e545930..8ef4ea6 100644
--- a/open-sse/config/errorConfig.js
+++ b/open-sse/config/errorConfig.js
@@ -36,6 +36,14 @@ export const BACKOFF_CONFIG = {
 };
 
 // Default cooldown for transient/unknown errors
+// Router-computed cooldowns triggered by 429/503 responses are scaled down
+// by this divisor: with several accounts in rotation and requests waiting
+// out exhaustion, long locks only starve the pool — a third of the nominal
+// backoff still spreads retries without keeping accounts out needlessly.
+// Provider-reported reset timestamps (resetsAtMs) are NOT scaled: they state
+// when the provider itself lifts the limit, and probing earlier is futile.
+export const RATE_LIMIT_COOLDOWN_DIVISOR = 3;
+
 export const TRANSIENT_COOLDOWN_MS = 30 * 1000;
 
 // Hard cap for provider-reported rate limit cooldown (e.g. codex resets_at can be 5-6h)
diff --git a/open-sse/services/accountFallback.js b/open-sse/services/accountFallback.js
index 08df099..991988c 100644
--- a/open-sse/services/accountFallback.js
+++ b/open-sse/services/accountFallback.js
@@ -1,4 +1,4 @@
-import { ERROR_RULES, BACKOFF_CONFIG, TRANSIENT_COOLDOWN_MS } from "../config/errorConfig.js";
+import { ERROR_RULES, BACKOFF_CONFIG, TRANSIENT_COOLDOWN_MS, RATE_LIMIT_COOLDOWN_DIVISOR } from "../config/errorConfig.js";
 
 /**
  * Calculate exponential backoff cooldown for rate limits (429)
@@ -27,6 +27,12 @@ export function getQuotaCooldown(backoffLevel = 0) {
  * this request, so combo rotation must still try the next member.
  */
 export function checkFallbackError(status, errorText, backoffLevel = 0, provider = null) {
+  // Cooldowns caused by 429/503 responses are scaled down (see
+  // RATE_LIMIT_COOLDOWN_DIVISOR); the backoff level still advances as before,
+  // so the ladder keeps its shape at a third of the durations.
+  const scaleCooldown = (status === 429 || status === 503)
+    ? (ms) => Math.max(1, Math.round(ms / RATE_LIMIT_COOLDOWN_DIVISOR))
+    : (ms) => ms;
   const lowerError = errorText
     ? (typeof errorText === "string" ? errorText : JSON.stringify(errorText)).toLowerCase()
     : "";
@@ -37,18 +43,18 @@ export function checkFallbackError(status, errorText, backoffLevel = 0, provider
     if (rule.text && lowerError && lowerError.includes(rule.text)) {
       if (rule.backoff) {
         const newLevel = Math.min(backoffLevel + 1, BACKOFF_CONFIG.maxLevel);
-        return { shouldFallback: true, cooldownMs: getQuotaCooldown(newLevel), newBackoffLevel: newLevel };
+        return { shouldFallback: true, cooldownMs: scaleCooldown(getQuotaCooldown(newLevel)), newBackoffLevel: newLevel };
       }
-      return { shouldFallback: true, cooldownMs: rule.cooldownMs };
+      return { shouldFallback: true, cooldownMs: scaleCooldown(rule.cooldownMs) };
     }
 
     // Status-based rule: match HTTP status code
     if (rule.status && rule.status === status) {
       if (rule.backoff) {
         const newLevel = Math.min(backoffLevel + 1, BACKOFF_CONFIG.maxLevel);
-        return { shouldFallback: true, cooldownMs: getQuotaCooldown(newLevel), newBackoffLevel: newLevel };
+        return { shouldFallback: true, cooldownMs: scaleCooldown(getQuotaCooldown(newLevel)), newBackoffLevel: newLevel };
       }
-      return { shouldFallback: true, cooldownMs: rule.cooldownMs };
+      return { shouldFallback: true, cooldownMs: scaleCooldown(rule.cooldownMs) };
     }
   }
 
@@ -67,7 +73,7 @@ export function checkFallbackError(status, errorText, backoffLevel = 0, provider
   }
 
   // Default: transient cooldown for any unmatched error
-  return { shouldFallback: true, cooldownMs: TRANSIENT_COOLDOWN_MS };
+  return { shouldFallback: true, cooldownMs: scaleCooldown(TRANSIENT_COOLDOWN_MS) };
 }
 
 /**
diff --git a/tests/unit/account-cooldown-division.test.js b/tests/unit/account-cooldown-division.test.js
new file mode 100644
index 0000000..b28d72c
--- /dev/null
+++ b/tests/unit/account-cooldown-division.test.js
@@ -0,0 +1,45 @@
+// Regression for the 429/503 cooldown division (RATE_LIMIT_COOLDOWN_DIVISOR = 3).
+// Only cooldowns caused by 429 and 503 are divided. Other statuses keep their
+// configured duration, and provider-reported reset timestamps are never divided.
+import { describe, expect, it } from "vitest";
+import { checkFallbackError } from "../../open-sse/services/accountFallback.js";
+import { RATE_LIMIT_COOLDOWN_DIVISOR, COOLDOWN_MS, TRANSIENT_COOLDOWN_MS } from "../../open-sse/config/errorConfig.js";
+
+describe("RATE_LIMIT_COOLDOWN_DIVISOR scales only 429 and 503", () => {
+  it("the divisor is 3", () => {
+    expect(RATE_LIMIT_COOLDOWN_DIVISOR).toBe(3);
+  });
+
+  it("a 503 with the short cooldown is divided by 3", () => {
+    const r = checkFallbackError(503, "upstream unavailable", 0, "p");
+    // COOLDOWN.short is 5000 ms for 503; the divisor brings it to round(5000 / 3).
+    expect(r.cooldownMs).toBe(Math.round(5000 / RATE_LIMIT_COOLDOWN_DIVISOR));
+  });
+
+  it("a 429 backoff level is divided by 3", () => {
+    // Backoff level 1 gives the base 2000 ms (getQuotaCooldown(1)); the divisor
+    // must bring it to round(2000 / 3), not leave the nominal value.
+    const r = checkFallbackError(429, "rate limit", 0, "p");
+    expect(r.cooldownMs).toBe(Math.round(2000 / RATE_LIMIT_COOLDOWN_DIVISOR));
+  });
+
+  it("a 502 keeps its undivided short cooldown", () => {
+    const r = checkFallbackError(502, "upstream unavailable", 0, "p");
+    expect(r.cooldownMs).toBe(5000);
+  });
+
+  it("a 504 keeps its undivided short cooldown", () => {
+    const r = checkFallbackError(504, "upstream unavailable", 0, "p");
+    expect(r.cooldownMs).toBe(5000);
+  });
+
+  it("an unmatched transient error keeps the undivided default cooldown", () => {
+    const r = checkFallbackError(500, "strange failure", 0, "p");
+    expect(r.cooldownMs).toBe(TRANSIENT_COOLDOWN_MS);
+  });
+
+  it("a 401 keeps its undivided account cooldown", () => {
+    const r = checkFallbackError(401, "unauthorized", 0, "p");
+    expect(r.cooldownMs).toBe(COOLDOWN_MS.unauthorized);
+  });
+});
-- 
