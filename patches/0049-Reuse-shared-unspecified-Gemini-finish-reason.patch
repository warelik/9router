From adc39d4783eacabfe1552ed3f8e075b8075be45a Mon Sep 17 00:00:00 2001
From: "github-actions[bot]" <github-actions[bot]>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH] Reuse shared unspecified Gemini finish reason

---
 open-sse/translator/schema/finishReasons.js | 1 +
 open-sse/utils/stream.js                    | 3 ++-
 tests/unit/gemini-native-stream.test.js     | 5 +++++
 3 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/open-sse/translator/schema/finishReasons.js b/open-sse/translator/schema/finishReasons.js
index d0cc6244..9143e9cf 100644
--- a/open-sse/translator/schema/finishReasons.js
+++ b/open-sse/translator/schema/finishReasons.js
@@ -32,6 +32,7 @@ export const RESPONSES_INCOMPLETE_REASON = {
 
 // Gemini finishReason values.
 export const GEMINI_FINISH = {
+  UNSPECIFIED: "FINISH_REASON_UNSPECIFIED",
   STOP: "STOP",
   MAX_TOKENS: "MAX_TOKENS",
   SAFETY: "SAFETY",
diff --git a/open-sse/utils/stream.js b/open-sse/utils/stream.js
index 733be6e4..ec0ae9e6 100644
--- a/open-sse/utils/stream.js
+++ b/open-sse/utils/stream.js
@@ -1,5 +1,6 @@
 import { translateResponse, initState } from "../translator/index.js";
 import { FORMATS } from "../translator/formats.js";
+import { GEMINI_FINISH } from "../translator/schema/index.js";
 import { PROVIDERS } from "../config/providers.js";
 import { HTTP_STATUS, NATIVE_GEMINI_FINISH_REASON_FIELDS, NATIVE_GEMINI_CANDIDATE_MASK_PREFIXES, NATIVE_GEMINI_FORMATS } from "../config/runtimeConfig.js";
 import { liftReasoningAliases } from "../translator/concerns/reasoning.js";
@@ -207,7 +208,7 @@ export function createSSEStream(options = {}) {
     for (const [position, candidate] of candidates.entries()) {
       if (!candidate || typeof candidate !== "object" || Array.isArray(candidate)) continue;
       const finished = typeof candidate.finishReason === "string"
-        && candidate.finishReason.length > 0 && candidate.finishReason !== "FINISH_REASON_UNSPECIFIED";
+        && candidate.finishReason.length > 0 && candidate.finishReason !== GEMINI_FINISH.UNSPECIFIED;
       if (finished) {
         nativeGeminiAnyFinishSeen = true;
       }
diff --git a/tests/unit/gemini-native-stream.test.js b/tests/unit/gemini-native-stream.test.js
index 5ecae0cf..e811e69e 100644
--- a/tests/unit/gemini-native-stream.test.js
+++ b/tests/unit/gemini-native-stream.test.js
@@ -1,4 +1,5 @@
 import { describe, expect, it, vi } from "vitest";
+import { GEMINI_FINISH } from "../../open-sse/translator/schema/index.js";
 
 vi.mock("@/lib/db/helpers/kvStore.js", () => ({
   makeKv: () => ({ get: async () => null, set: async () => {}, remove: async () => {}, getAll: async () => ({}) }),
@@ -38,6 +39,10 @@ const nativeTransform = (provider, source = FORMATS.GEMINI, complete = null, nat
 const readText = stream => new Response(stream).text();
 
 describe("native Gemini SSE preserves provider payload and follows the client protocol", () => {
+  it("shares the exact unspecified Gemini finish-reason wire value", () => {
+    expect(GEMINI_FINISH.UNSPECIFIED).toBe("FINISH_REASON_UNSPECIFIED");
+  });
+
   it.each([
     ["openai", FORMATS.OPENAI, 'data: {"choices":[{"delta":{"content":"fixture"},"finish_reason":"stop"}]}\n\ndata: [DONE]\n\n'],
     ["claude", FORMATS.CLAUDE, 'event: message_stop\ndata: {"type":"message_stop"}\n\n'],
