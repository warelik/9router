+// AIStudioToAPI (https://github.com/iBUHub/AIStudioToAPI): a local bridge that drives Google AI
+// Studio in a browser. Only its Gemini-native `/v1beta` surface returns the real
+// `thoughtSignature` of a thinking turn; its OpenAI and Claude surfaces drop it (or fake it), and
+// without it the model cannot use its own earlier reasoning. So this provider talks Gemini wire.
+// The model list is whatever the bridge serves, hence passthroughModels and no seeded ids.
+import { FORMATS } from "../../translator/formats.js";
+
+export default {
+  id: "aistudio",
+  priority: 60,
+  alias: "aistudio",
+  display: {
+    name: "AIStudioToAPI",
+    icon: "diamond",
+    color: "#4285F4",
+    textIcon: "AS",
+    website: "https://github.com/iBUHub/AIStudioToAPI",
+    notice: {
+      text: "Local bridge on 127.0.0.1:7860 (Gemini-native wire). The API key is one of API_KEYS from the bridge's env file.",
+    },
+  },
+  category: "apikey",
+  authType: "apikey",
+  authModes: ["apikey"],
+  transport: {
+    baseUrl: "http://127.0.0.1:7860/v1beta/models",
+    format: FORMATS.GEMINI,
+    validateUrl: "http://127.0.0.1:7860/v1/models",
+    auth: {
+      apiKey: {
+        header: "x-goog-api-key",
+        scheme: "raw",
+      },
+    },
+  },
+  models: [],
+  passthroughModels: true,
+};
diff --git a/open-sse/services/aistudioModels.js b/open-sse/services/aistudioModels.js
new file mode 100644
index 0000000..cd8ec80
--- /dev/null
+++ b/open-sse/services/aistudioModels.js
@@ -0,0 +1,30 @@
+import { PROVIDERS } from "../config/providers.js";
+import { proxyAwareFetch } from "../utils/proxyFetch.js";
+import { FETCH_CONNECT_TIMEOUT_MS, HTTP_STATUS } from "../config/runtimeConfig.js";
+
+// The registry is intentionally unseeded; keep bridge model IDs opaque.
+export async function resolveAIStudioModels(credentials, options = {}) {
+  const apiKey = credentials?.apiKey;
+  if (!apiKey) {
+    return { error: "No valid token found", status: HTTP_STATUS.UNAUTHORIZED };
+  }
+  const res = await proxyAwareFetch(PROVIDERS.aistudio.validateUrl, {
+    headers: {
+      "Authorization": `Bearer ${apiKey}`,
+      "Accept": "application/json",
+    },
+    signal: AbortSignal.timeout(FETCH_CONNECT_TIMEOUT_MS),
+  }, options.proxyOptions || null);
+  if (!res.ok) {
+    return { error: `Failed to fetch models: ${res.status}`, status: res.status };
+  }
+  const data = await res.json();
+  const rows = (Array.isArray(data?.data) ? data.data : [])
+    .filter((entry) => typeof entry?.id === "string" && entry.id.length > 0);
+  return {
+    models: rows.map((entry) => ({
+      ...entry,
+      name: entry.name || entry.display_name || entry.id,
+    })),
+  };
+}
