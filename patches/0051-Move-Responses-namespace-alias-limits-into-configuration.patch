From 41e885061bd9522da5c64b4bc0547c1b5a7e0f97 Mon Sep 17 00:00:00 2001
From: "github-actions[bot]" <github-actions[bot]>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH] Move Responses namespace alias limits into configuration

---
 open-sse/config/runtimeConfig.js                | 7 +++++++
 open-sse/translator/request/openai-responses.js | 7 ++++---
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/open-sse/config/runtimeConfig.js b/open-sse/config/runtimeConfig.js
index 94e5f4a7..792cced2 100644
--- a/open-sse/config/runtimeConfig.js
+++ b/open-sse/config/runtimeConfig.js
@@ -100,6 +100,13 @@ export const PORTABLE_COLLABORATION = {
   aliasCollisionBaseLength: 58,
 };
 
+export const RESPONSES_NAMESPACE_ALIAS = {
+  prefix: "ns_",
+  stemLength: 40,
+  hashLength: 16,
+  maxLength: 64,
+};
+
 // Retry config for 429 responses (legacy - kept for backward compatibility)
 export const RETRY_CONFIG = {
   maxAttempts: 2,
diff --git a/open-sse/translator/request/openai-responses.js b/open-sse/translator/request/openai-responses.js
index 59f01c09..1f2b4a7d 100644
--- a/open-sse/translator/request/openai-responses.js
+++ b/open-sse/translator/request/openai-responses.js
@@ -7,6 +7,7 @@
 import { createHash } from "crypto";
 import { register } from "../index.js";
 import { FORMATS } from "../formats.js";
+import { RESPONSES_NAMESPACE_ALIAS } from "../../config/runtimeConfig.js";
 import {
   normalizeResponsesInput,
   normalizeResponsesAgentMessage,
@@ -54,13 +55,13 @@ export function openaiResponsesToOpenAIRequest(model, body, stream, credentials)
   const aliasFor = (namespace, name, type) => {
     const identity = JSON.stringify([namespace, name, type]);
     if (aliasCache.has(identity)) return aliasCache.get(identity);
-    const stem = `ns_${namespace}_${name}`.replace(/[^A-Za-z0-9_-]/g, "_").slice(0, 40);
-    const hash = createHash("sha256").update(identity).digest("hex").slice(0, 16);
+    const stem = `${RESPONSES_NAMESPACE_ALIAS.prefix}${namespace}_${name}`.replace(/[^A-Za-z0-9_-]/g, "_").slice(0, RESPONSES_NAMESPACE_ALIAS.stemLength);
+    const hash = createHash("sha256").update(identity).digest("hex").slice(0, RESPONSES_NAMESPACE_ALIAS.hashLength);
     const base = `${stem}_${hash}`;
     let alias = base;
     for (let i = 1; reservedNames.has(alias); i++) {
       const suffix = `_${i}`;
-      alias = `${base.slice(0, 64 - suffix.length)}${suffix}`;
+      alias = `${base.slice(0, RESPONSES_NAMESPACE_ALIAS.maxLength - suffix.length)}${suffix}`;
     }
     reservedNames.add(alias);
     aliasCache.set(identity, alias);
-- 
