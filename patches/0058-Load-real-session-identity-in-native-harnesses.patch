diff --git a/tests/translator/golden-url-header.test.js b/tests/translator/golden-url-header.test.js
index 881eb6ab..8a3f6675 100644
--- a/tests/translator/golden-url-header.test.js
+++ b/tests/translator/golden-url-header.test.js
@@ -27,12 +27,21 @@ const SPECIALIZED = new Set([
 
 // Per-process / per-request values: kimi's random device name, minimax's session UUID.
 const VOLATILE_HEADERS = new Set(["x-msh-device-name", "x-mavis-session-id"]);
+// Environment stamps: the router release version and the Node runtime version
+// change independently of the header contract locked here.
+const VERSION_HEADERS = new Set(["user-agent", "x-client-version", "x-core-version", "x-platform-version", "x-msh-version"]);
 
 // Sanitize header: khử token + field thời gian động (kimi X-Msh-Device-Id) để snapshot ổn định.
 function sanitize(headers) {
   const out = {};
   for (const [k, v] of Object.entries(headers)) {
     if (VOLATILE_HEADERS.has(k.toLowerCase())) { out[k] = "<VOLATILE>"; continue; }
+    if (VERSION_HEADERS.has(k.toLowerCase()) && typeof v === "string") {
+      out[k] = k.toLowerCase() === "user-agent"
+        ? v.replace(/9Router\/\d+\.\d+\.\d+/g, "9Router/<VER>")
+        : v.replace(/\d+\.\d+\.\d+/g, "<VER>");
+      continue;
+    }
     out[k] = typeof v === "string"
       ? v.replace(/Bearer .+/, "Bearer <TOK>")
           .replace(/sk-test-APIKEY|tok-test-ACCESS/g, "<CRED>")
