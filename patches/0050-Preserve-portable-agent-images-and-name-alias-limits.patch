From b4153afaf129eee461cd52ffdf32690594788add Mon Sep 17 00:00:00 2001
From: "github-actions[bot]"
 <41898282+github-actions[bot]@users.noreply.github.com>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH] Preserve portable agent images and name alias limits

---
 open-sse/config/runtimeConfig.js                   |  3 +++
 .../translator/concerns/portableCollaboration.js   |  7 ++++---
 open-sse/translator/formats/responsesApi.js        |  2 +-
 tests/unit/kimi-portable-responses-input.test.js   | 22 ++++++++++++++++++++++
 4 files changed, 30 insertions(+), 4 deletions(-)

diff --git a/open-sse/config/runtimeConfig.js b/open-sse/config/runtimeConfig.js
index 047ae40..94e5f4a 100644
--- a/open-sse/config/runtimeConfig.js
+++ b/open-sse/config/runtimeConfig.js
@@ -95,6 +95,9 @@ export const PORTABLE_COLLABORATION = {
   namespace: "collaboration",
   messageTools: ["spawn_agent", "send_message", "followup_task"],
   aliasPrefix: "collab_plain_",
+  aliasHashLength: 16,
+  aliasNameLength: 30,
+  aliasCollisionBaseLength: 58,
 };
 
 // Retry config for 429 responses (legacy - kept for backward compatibility)
diff --git a/open-sse/translator/concerns/portableCollaboration.js b/open-sse/translator/concerns/portableCollaboration.js
index 9cc6da4..84d70d4 100644
--- a/open-sse/translator/concerns/portableCollaboration.js
+++ b/open-sse/translator/concerns/portableCollaboration.js
@@ -40,10 +40,11 @@ export function preparePortableCollaboration(body) {
   const aliasFor = (name, type = RESPONSES_TOOL.FUNCTION) => {
     const identity = JSON.stringify([namespace, name, type]);
     if (aliases.has(identity)) return aliases.get(identity);
-    const hash = createHash("sha256").update(identity).digest("hex").slice(0, 16);
-    const base = PORTABLE_COLLABORATION.aliasPrefix + String(name).replace(/[^A-Za-z0-9_-]/g, "_").slice(0, 30) + "_" + hash;
+    const hash = createHash("sha256").update(identity).digest("hex").slice(0, PORTABLE_COLLABORATION.aliasHashLength);
+    const base = PORTABLE_COLLABORATION.aliasPrefix
+      + String(name).replace(/[^A-Za-z0-9_-]/g, "_").slice(0, PORTABLE_COLLABORATION.aliasNameLength) + "_" + hash;
     let alias = base;
-    for (let n = 1; reserved.has(alias); n++) alias = base.slice(0, 58) + "_" + n;
+    for (let n = 1; reserved.has(alias); n++) alias = base.slice(0, PORTABLE_COLLABORATION.aliasCollisionBaseLength) + "_" + n;
     reserved.add(alias); aliases.set(identity, alias);
     toolNameMap.set(alias, { name, namespace, type });
     return alias;
diff --git a/open-sse/translator/formats/responsesApi.js b/open-sse/translator/formats/responsesApi.js
index fe3d93c..e89b54b 100644
--- a/open-sse/translator/formats/responsesApi.js
+++ b/open-sse/translator/formats/responsesApi.js
@@ -83,7 +83,7 @@ export function toPortableResponsesInput(input) {
     if (item.type === RESPONSES_ITEM.AGENT_MESSAGE) {
       const message = normalizeResponsesAgentMessage(item);
       const parts = Array.isArray(message.content)
-        ? message.content.filter((c) => c?.type === RESPONSES_ITEM.INPUT_TEXT)
+        ? message.content.filter((c) => c?.type === RESPONSES_ITEM.INPUT_TEXT || c?.type === RESPONSES_ITEM.INPUT_IMAGE)
         : [];
       if (parts.length > 0) {
         out.push({ type: RESPONSES_ITEM.MESSAGE, role: ROLE.USER, content: parts });
diff --git a/tests/unit/kimi-portable-responses-input.test.js b/tests/unit/kimi-portable-responses-input.test.js
index b7b4464..d8a3bb5 100644
--- a/tests/unit/kimi-portable-responses-input.test.js
+++ b/tests/unit/kimi-portable-responses-input.test.js
@@ -97,6 +97,28 @@ describe("toPortableResponsesInput", () => {
     expect(out).toEqual([]);
   });
 
+  it("keeps input_image parts of agent_message beside its input_text", () => {
+    const image = { type: "input_image", image_url: "data:image/png;base64,x" };
+    const out = toPortableResponsesInput([{
+      type: "agent_message",
+      content: [
+        { type: "input_text", text: "see image" },
+        image,
+        { type: "encrypted_content", encrypted_content: FERNET },
+      ],
+    }]);
+    expect(out).toEqual([{
+      type: "message", role: "user",
+      content: [{ type: "input_text", text: "see image" }, image],
+    }]);
+  });
+
+  it("keeps an image-only agent_message", () => {
+    const image = { type: "input_image", image_url: "data:image/png;base64,x" };
+    const out = toPortableResponsesInput([{ type: "agent_message", content: [image] }]);
+    expect(out).toEqual([{ type: "message", role: "user", content: [image] }]);
+  });
+
   it("rewrites call_id-less function_call_output with a string output", () => {
     const out = toPortableResponsesInput([{
       type: "function_call_output", name: "send_message_to_thread",
