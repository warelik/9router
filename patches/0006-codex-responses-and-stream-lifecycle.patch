+import { describe, expect, it } from "vitest";
+import { kiroToOpenAIResponse } from "../../open-sse/translator/response/kiro-to-openai.js";
+import { kiroToClaudeResponse, kiroToClaudeNonStreaming } from "../../open-sse/translator/response/kiro-to-claude.js";
+
+const wire = "alpha_read";
+const descriptorMap = () => new Map([[wire, { name: "read", namespace: "alpha", type: "function" }]]);
+const normalizedChunk = (name, delta = {}, finish = null) => ({
+  id: "chatcmpl-kiro", object: "chat.completion.chunk", created: 1, model: "kiro",
+  choices: [{ index: 0, delta: { tool_calls: [{ index: 0, id: "call_kiro", type: "function", function: { name, arguments: '{"title":"x"}' } }], ...delta }, finish_reason: finish }],
+});
+
+describe("Kiro response adapters keep descriptor maps off the wire name", () => {
+  it("raw toolUseEvent yields the string wire alias", () => {
+    const out = kiroToOpenAIResponse({ toolUseEvent: { toolUseId: "call_kiro", name: wire, input: { title: "x" } } }, { toolNameMap: descriptorMap() });
+    const call = out.choices[0].delta.tool_calls[0];
+    expect(call.function.name).toBe(wire);
+    expect(call).toMatchObject({ id: "call_kiro" });
+    expect(call.function.arguments).toBe('{"title":"x"}');
+  });
+
+  it("executor-normalized chunk yields the string wire alias", () => {
+    const out = kiroToOpenAIResponse(normalizedChunk(wire), { toolNameMap: descriptorMap() });
+    expect(out.choices[0].delta.tool_calls[0].function.name).toBe(wire);
+  });
+
+  it("Kiro to Claude streaming and non-streaming yield the string wire alias", () => {
+    const state = { toolNameMap: descriptorMap(), nextBlockIndex: 0 };
+    const events = kiroToClaudeResponse(normalizedChunk(wire), state);
+    const start = events.find(e => e.type === "content_block_start");
+    expect(start.content_block.name).toBe(wire);
+    expect(start.content_block.id).toBe("call_kiro");
+    const message = kiroToClaudeNonStreaming({ _toolNameMap: descriptorMap(), choices: [{ message: { tool_calls: [{ id: "call_kiro", function: { name: wire, arguments: '{"title":"x"}' } }] }, finish_reason: "tool_calls" }] });
+    expect(message.content[0]).toMatchObject({ type: "tool_use", id: "call_kiro", name: wire, input: { title: "x" } });
+  });
+
+  it("plain string map entries still restore the original tool name", () => {
+    const out = kiroToOpenAIResponse(normalizedChunk("wire_plain"), { toolNameMap: new Map([["wire_plain", "original_tool"]]) });
+    expect(out.choices[0].delta.tool_calls[0].function.name).toBe("original_tool");
+  });
+});
diff --git a/tests/unit/openai-responses-incomplete.test.js b/tests/unit/openai-responses-incomplete.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..7a7a2bd9c2b8d9dd72280025709e196a00d5abec
--- /dev/null
+++ b/tests/unit/openai-responses-incomplete.test.js
@@ -0,0 +1,67 @@
+import { describe, expect, it } from "vitest";
+import { FORMATS } from "../../open-sse/translator/formats.js";
+import { createSSETransformStreamWithLogger } from "../../open-sse/utils/stream.js";
+
+async function run(chunks, format, provider) {
+  const input = chunks.map(chunk => `data: ${JSON.stringify(chunk)}\n\n`).join("");
+  const stream = new ReadableStream({ start(controller) { controller.enqueue(new TextEncoder().encode(input)); controller.close(); } });
+  const output = await new Response(stream.pipeThrough(createSSETransformStreamWithLogger(format, FORMATS.OPENAI_RESPONSES, provider, null, null, "gemini-3.8-flash"))).text();
+  return output.split("\n").filter(line => line.startsWith("data: {")).map(line => JSON.parse(line.slice(6)));
+}
+
+const targets = [
+  [FORMATS.GEMINI, "gemini"],
+  [FORMATS.GEMINI, "aistudio"],
+  [FORMATS.ANTIGRAVITY, "antigravity"],
+];
+const usageMetadata = { promptTokenCount: 90, candidatesTokenCount: 10, thoughtsTokenCount: 10, cachedContentTokenCount: 40, totalTokenCount: 110 };
+const expectedUsage = { input_tokens: 90, output_tokens: 20, total_tokens: 110, input_tokens_details: { cached_tokens: 40 }, output_tokens_details: { reasoning_tokens: 10 } };
+
+for (const [format, provider] of targets) {
+  describe(`${provider} to Responses terminal truth`, () => {
+    for (const [finishReason, expectedReason] of [["MAX_TOKENS", "max_output_tokens"], ["SAFETY", "content_filter"]]) {
+      for (const text of ["", "частичный ответ"]) {
+        it(`${finishReason} with ${text ? "partial text" : "empty text"} is incomplete`, async () => {
+          const response = { candidates: [{ content: { parts: text ? [{ text }] : [] }, finishReason }], usageMetadata };
+          const events = await run([format === FORMATS.ANTIGRAVITY ? { response } : response], format, provider);
+          const terminals = events.filter(event => ["response.completed", "response.incomplete", "response.failed"].includes(event.type));
+          expect(terminals).toHaveLength(1);
+          expect(terminals[0]).toMatchObject({ type: "response.incomplete", response: { status: "incomplete", incomplete_details: { reason: expectedReason }, error: null, usage: expectedUsage } });
+          expect(events.some(event => event.type === "response.completed")).toBe(false);
+        });
+      }
+    }
+    it("STOP still completes and retains usage", async () => {
+      const response = { candidates: [{ content: { parts: [{ text: "полный ответ" }] }, finishReason: "STOP" }], usageMetadata };
+      const events = await run([format === FORMATS.ANTIGRAVITY ? { response } : response], format, provider);
+      const terminals = events.filter(event => ["response.completed", "response.incomplete", "response.failed"].includes(event.type));
+      expect(terminals).toHaveLength(1);
+      expect(terminals[0]).toMatchObject({ type: "response.completed", response: { status: "completed", usage: expectedUsage } });
+      expect(terminals[0].response.incomplete_details).toBeUndefined();
+    });
+  });
+}
+
+it("direct OpenAI length retains its reason through a late usage trailer", async () => {
+  const events = await run([
+    { id: "fixture", choices: [{ index: 0, delta: { content: "partial" }, finish_reason: null }] },
+    { id: "fixture", choices: [{ index: 0, delta: {}, finish_reason: "length" }] },
+    { choices: [], usage: { prompt_tokens: 90, completion_tokens: 20, prompt_tokens_details: { cached_tokens: 40 }, completion_tokens_details: { reasoning_tokens: 10 } } },
+  ], FORMATS.OPENAI, "openai");
+  const terminals = events.filter(event => ["response.completed", "response.incomplete", "response.failed"].includes(event.type));
+  expect(terminals).toHaveLength(1);
+  expect(terminals[0]).toMatchObject({ type: "response.incomplete", response: { status: "incomplete", incomplete_details: { reason: "max_output_tokens" }, usage: expectedUsage } });
+});
+
+it("native Responses incomplete is terminal without an added disconnect failure", async () => {
+  const events = await run([{ type: "response.incomplete", response: { id: "fixture", status: "incomplete", incomplete_details: { reason: "max_output_tokens" }, usage: expectedUsage } }], FORMATS.OPENAI_RESPONSES, "codex");
+  expect(events.filter(event => event.type === "response.incomplete")).toHaveLength(1);
+  expect(events.some(event => event.type === "response.failed")).toBe(false);
+});
+
+it("terminal guard recognizes incomplete event and status fallback", async () => {
+  const { isOpenAIResponsesTerminalEvent } = await import("../../open-sse/utils/responsesStreamHelpers.js");
+  expect(isOpenAIResponsesTerminalEvent("response.incomplete", {})).toBe(true);
+  expect(isOpenAIResponsesTerminalEvent(null, { response: { status: "incomplete" } })).toBe(true);
+  expect(isOpenAIResponsesTerminalEvent(null, { response: { status: "in_progress" } })).toBe(false);
+});
diff --git a/tests/unit/responses-output-index.test.js b/tests/unit/responses-output-index.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..f5b8bfdb131776010992c3af8da7a45a11e8dcf3
--- /dev/null
+++ b/tests/unit/responses-output-index.test.js
@@ -0,0 +1,78 @@
+import { describe, expect, it } from "vitest";
+
+import { FORMATS } from "../../open-sse/translator/formats.js";
+import { initState } from "../../open-sse/translator/index.js";
+import { openaiToOpenAIResponsesResponse } from "../../open-sse/translator/response/openai-responses.js";
+
+// Chat -> Responses stream: every output item (reasoning, message, each tool call) must get
+// its own output_index, and response.completed.output must keep all of them in emission order.
+// Regression: reasoning, the message and the first tool call all used index 0, so clients saw a
+// repeated output_item.done index and the reasoning item was overwritten in completed.output.
+function run(chunks) {
+  const state = { ...initState(FORMATS.OPENAI_RESPONSES), targetFormat: FORMATS.OPENAI };
+  const events = [];
+  for (const chunk of chunks) events.push(...openaiToOpenAIResponsesResponse(chunk, state));
+  events.push(...openaiToOpenAIResponsesResponse(null, state));
+  return events;
+}
+
+const chunk = (delta, finish_reason) => ({ id: "chatcmpl-1", choices: [{ index: 0, delta, ...(finish_reason ? { finish_reason } : {}) }] });
+const reasoning = (text) => chunk({ reasoning_content: text });
+const text = (t) => chunk({ content: t });
+const call = (index, id, name, args) => chunk({ tool_calls: [{ index, id, type: "function", function: { name, arguments: args } }] });
+const finish = (reason = "stop") => ({ id: "chatcmpl-1", choices: [{ index: 0, delta: {}, finish_reason: reason }], usage: { prompt_tokens: 5, completion_tokens: 5 } });
+
+const byEvent = (events, name) => events.filter((e) => e.event === name);
+const completed = (events) => byEvent(events, "response.completed")[0].data.response;
+
+function expectConsistentIndices(events) {
+  const added = byEvent(events, "response.output_item.added").map((e) => ({ index: e.data.output_index, id: e.data.item.id }));
+  const done = byEvent(events, "response.output_item.done").map((e) => ({ index: e.data.output_index, id: e.data.item.id }));
+  expect(new Set(added.map((a) => a.index)).size, "output_item.added indices must be unique").toBe(added.length);
+  expect(new Set(done.map((d) => d.index)).size, "output_item.done indices must be unique").toBe(done.length);
+  for (const item of added) {
+    expect(done.find((d) => d.id === item.id)?.index, `done index of ${item.id}`).toBe(item.index);
+  }
+  // Every event that names an item must use the index that item was added with.
+  const indexOf = new Map(added.map((a) => [a.id, a.index]));
+  for (const e of events) {
+    if (e.data?.item_id && e.data.output_index !== undefined) {
+      expect(e.data.output_index, `${e.event} for ${e.data.item_id}`).toBe(indexOf.get(e.data.item_id));
+    }
+  }
+  expect(added.map((a) => a.index)).toEqual(added.map((_, i) => i));
+  return added;
+}
+
+describe("Responses output_index allocation", () => {
+  it("gives reasoning and the following message different indices and keeps both in completed.output", () => {
+    const events = run([reasoning("think"), text("answer"), finish()]);
+    const added = expectConsistentIndices(events);
+    expect(added).toHaveLength(2);
+    expect(completed(events).output.map((o) => o.type)).toEqual(["reasoning", "message"]);
+  });
+
+  it("gives reasoning and the first tool call different indices", () => {
+    const events = run([reasoning("think"), call(0, "call_a", "lookup", "{\"q\":1}"), finish("tool_calls")]);
+    expectConsistentIndices(events);
+    expect(completed(events).output.map((o) => o.type)).toEqual(["reasoning", "function_call"]);
+  });
+
+  it("orders reasoning, message and parallel tool calls by first appearance", () => {
+    const events = run([
+      reasoning("think"), text("let me check"),
+      call(0, "call_a", "lookup", "{}"), call(1, "call_b", "lookup", "{}"),
+      finish("tool_calls"),
+    ]);
+    expectConsistentIndices(events);
+    expect(completed(events).output.map((o) => o.type)).toEqual(["reasoning", "message", "function_call", "function_call"]);
+    expect(completed(events).output.filter((o) => o.type === "function_call").map((o) => o.call_id)).toEqual(["call_a", "call_b"]);
+  });
+
+  it("keeps the old indices for the cases that never collided", () => {
