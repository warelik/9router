Subject: [PATCH] Preserve nested provider model IDs through both Gemini API
 routes

---
 src/app/api/v1beta/models/[...path]/route.js | 32 ++++----------------
 tests/unit/gemini-native-api-version.test.js | 23 ++++++++++++++
 2 files changed, 29 insertions(+), 26 deletions(-)

diff --git a/src/app/api/v1beta/models/[...path]/route.js b/src/app/api/v1beta/models/[...path]/route.js
index 46415895..bf9b54c4 100644
--- a/src/app/api/v1beta/models/[...path]/route.js
+++ b/src/app/api/v1beta/models/[...path]/route.js
@@ -63,32 +63,12 @@ export async function POST(request, { params }) {
     if (!/:(?:generateContent|streamGenerateContent)$/.test(actionPath || "")) {
       return new Response(null, { status: 405, headers: { Allow: "POST, OPTIONS" } });
     }
-    // path = ["provider", "model:action"] or ["model:action"]
-
-    let model;
-    let action; // ":generateContent" | ":streamGenerateContent"
-
-    if (path.length >= 2) {
-      // Format: /v1beta/models/provider/model:generateContent
-      const provider = path[0];
-      const modelAction = path[1];
-      action = modelAction.includes(":streamGenerateContent")
-        ? ":streamGenerateContent"
-        : ":generateContent";
-      const modelName = modelAction
-        .replace(":streamGenerateContent", "")
-        .replace(":generateContent", "");
-      model = provider + "/" + modelName;
-    } else {
-      // Format: /v1beta/models/model:generateContent
-      const modelAction = path[0];
-      action = modelAction.includes(":streamGenerateContent")
-        ? ":streamGenerateContent"
-        : ":generateContent";
-      model = modelAction
-        .replace(":streamGenerateContent", "")
-        .replace(":generateContent", "");
-    }
+    // Provider model IDs can themselves contain slashes. Only the final
+    // segment carries the validated action suffix; retain every model segment.
+    const action = actionPath.endsWith(":streamGenerateContent")
+      ? ":streamGenerateContent"
+      : ":generateContent";
+    const model = path.join("/").slice(0, -action.length);
 
     let body;
     try {
diff --git a/tests/unit/gemini-native-api-version.test.js b/tests/unit/gemini-native-api-version.test.js
index fa44646c..4054492f 100644
--- a/tests/unit/gemini-native-api-version.test.js
+++ b/tests/unit/gemini-native-api-version.test.js
@@ -119,6 +119,29 @@ describe("Gemini native stable and beta API versions", () => {
     }
   }
 
+  for (const version of ["v1", "v1beta"]) {
+    for (const action of ["generateContent", "streamGenerateContent"]) {
+      it(`${version} ${action} preserves nested provider model IDs`, async () => {
+        const model = "kilocode/google/gemini-2.5-pro";
+        const input = body();
+        const request = new Request(`https://router.test/${version}/models/${model}:${action}`, {
+          method: "POST", headers: { "Content-Type": "application/json" },
+          body: JSON.stringify(input),
+        });
+        const segments = ["kilocode", "google", `gemini-2.5-pro:${action}`];
+        const route = version === "v1" ? stable : beta;
+        const params = version === "v1" ? { model: segments } : { path: segments };
+        const response = await route.POST(request, { params: Promise.resolve(params) });
+        expect(response.status).toBe(200);
+        expect(mocks.handleChat).toHaveBeenCalledTimes(1);
+        const [forwarded, raw] = mocks.handleChat.mock.calls[0];
+        expect(await forwarded.json()).toMatchObject({ model, stream: action === "streamGenerateContent" });
+        expect(raw.apiVersion).toBe(version);
+        expect(mocks.proxyAwareFetch).not.toHaveBeenCalled();
+      });
+    }
+  }
+
   it("the native AUDIO path forwards stable v1 to Google", async () => {
     const input = { contents: [{ parts: [{ text: "Speak" }] }], generationConfig: { responseModalities: ["AUDIO"] } };
     const request = new Request("https://router.test/v1/models/tts-model:generateContent?key=fixture-client-key&fields=candidates", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(input) });
