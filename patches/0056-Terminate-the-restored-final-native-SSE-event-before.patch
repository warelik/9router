From 02759ce02a808a30fdc0217a099cd1fd7957b1b1 Mon Sep 17 00:00:00 2001
From: warelik <warelik@gmail.com>
Date: Tue, 27 Oct 2026 08:28:01 +0000
Subject: [PATCH] Terminate the restored final native SSE event before closing

---
 open-sse/utils/stream.js                | 7 ++++---
 tests/unit/gemini-native-stream.test.js | 1 +
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/open-sse/utils/stream.js b/open-sse/utils/stream.js
index 47a2b33a..0f2b994e 100644
--- a/open-sse/utils/stream.js
+++ b/open-sse/utils/stream.js
@@ -794,11 +794,12 @@ export function createSSEStream(options = {}) {
               controller.enqueue(failure);
             } else {
               if (toolNameMap?.size) {
+                const sseEvent = buffer
+                  ? restoreSseEvent([...nativeSseEvent, buffer], toolNameMap)
+                  : nativeSseEvent.length ? restoreSseEvent(nativeSseEvent, toolNameMap) : "";
                 const tail = nativeJson
                   ? JSON.stringify(restoreToolNames(JSON.parse(nativeGeminiJson), toolNameMap))
-                  : buffer
-                    ? restoreSseEvent([...nativeSseEvent, buffer], toolNameMap)
-                    : nativeSseEvent.length ? restoreSseEvent(nativeSseEvent, toolNameMap) + "\n" : "";
+                  : sseEvent ? sseEvent + "\n\n" : "";
                 if (tail) {
                   reqLogger?.appendConvertedChunk?.(tail);
                   controller.enqueue(sharedEncoder.encode(tail));
diff --git a/tests/unit/gemini-native-stream.test.js b/tests/unit/gemini-native-stream.test.js
index afa094e3..35a17d9e 100644
--- a/tests/unit/gemini-native-stream.test.js
+++ b/tests/unit/gemini-native-stream.test.js
@@ -633,6 +633,7 @@ describe("native stream integration and failure cleanup", () => {
     const output = await readText(inputStream([encode(raw)])
       .pipeThrough(nativeTransform("aistudio", FORMATS.GEMINI, null, false, null, null, toolNameMap)));
     expect(output).toContain('"id":"call-4"');
+    expect(output.endsWith("\n\n")).toBe(true);
     expect(output).toContain('"name":"original_tool"');
     expect(output).not.toContain("wire_tool");
   });
-- 
