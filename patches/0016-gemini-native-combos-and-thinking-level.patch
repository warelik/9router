diff --git a/open-sse/services/combo.js b/open-sse/services/combo.js
index b96a2efacae69609ba8bea975c7f8633b72d345d..65207b65ef9b5312e1d6ba21ecff0ef415d14c92 100644
--- a/open-sse/services/combo.js
+++ b/open-sse/services/combo.js
@@ -331,6 +331,30 @@ export function isZeroContentResponse(data) {
     }
   }
 
+  // Gemini generateContent format
+  const geminiCandidates = Array.isArray(data.candidates)
+    ? data.candidates
+    : (Array.isArray(data.response?.candidates) ? data.response.candidates : null);
+  if (geminiCandidates) {
+    if (geminiCandidates.length === 0) return true;
+    const candidate = geminiCandidates[0];
+    if (!candidate) return true;
+    const parts = Array.isArray(candidate.content?.parts) ? candidate.content.parts : [];
+    const hasContent = parts.some((p) =>
+      (typeof p?.text === "string" && p.text.trim().length > 0 && p.thought !== true)
+      || Boolean(p?.functionCall)
+      || Boolean(p?.inlineData?.data)
+      || Boolean(p?.fileData?.fileUri)
+      || Boolean(p?.executableCode)
+      || Boolean(p?.codeExecutionResult)
+    );
+    const finish = String(candidate.finishReason || "").toUpperCase();
+    const isContentFilter = finish === "SAFETY" || finish === "RECITATION" || finish === "BLOCKLIST" || finish === "PROHIBITED_CONTENT";
+    if (!hasContent && !isContentFilter && finish !== "STOP" && finish !== "MAX_TOKENS") {
+      return true;
+    }
+  }
+
   return false;
 }
 
diff --git a/open-sse/services/emptyFailover.js b/open-sse/services/emptyFailover.js
index 5e8d1646a25c8c7ea9f8b3d84f070b610ef95e17..bc5ea7b7f2d1411464fab7a2231f52395f6360d3 100644
--- a/open-sse/services/emptyFailover.js
+++ b/open-sse/services/emptyFailover.js
@@ -108,9 +108,34 @@ function inspectResponsesEvent(obj) {
 
 // Inspect one complete client-format SSE line (parsed with the shared parseSSELine) and report
 // whether it carries content and/or a finish reason. Non-data lines and "[DONE]" carry nothing.
+function geminiPartHasClientContent(part) {
+  if (!part || typeof part !== "object") return false;
+  if (nonEmptyString(part.text) && part.thought !== true) return true;
+  if (part.functionCall || part.executableCode || part.codeExecutionResult) return true;
+  if (nonEmptyString(part.inlineData?.data) || nonEmptyString(part.fileData?.fileUri)) return true;
+  return false;
+}
+
+function inspectGeminiEvent(obj) {
+  const candidates = Array.isArray(obj.candidates) ? obj.candidates : obj.response?.candidates;
+  let content = false, finishReason = null;
+  for (const candidate of candidates || []) {
+    for (const part of candidate?.content?.parts || []) {
+      if (geminiPartHasClientContent(part)) content = true;
+    }
+    if (candidate?.finishReason) {
+      finishReason = toOpenAIFinish(candidate.finishReason, FORMATS.GEMINI);
+    }
+  }
+  return { content, finishReason };
+}
+
 export function inspectSSELine(line) {
   const parsed = parseSSELine(line.trimStart());
   if (!parsed || parsed.done) return { content: false, finishReason: null };
+  if (Array.isArray(parsed.candidates) || Array.isArray(parsed.response?.candidates)) {
+    return inspectGeminiEvent(parsed);
+  }
   if (typeof parsed.type === "string" && !Array.isArray(parsed.choices)) {
     return parsed.type.startsWith(RESPONSES_EVENT_PREFIX) ? inspectResponsesEvent(parsed) : inspectClaudeEvent(parsed);
   }
diff --git a/open-sse/translator/concerns/thinkingUnified.js b/open-sse/translator/concerns/thinkingUnified.js
index 6a56daffe007fa90ae7efce130d1992f638330c8..5bb5f507c8d393b93130e4823833d2fc47674d71 100644
--- a/open-sse/translator/concerns/thinkingUnified.js
